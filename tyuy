library ieee;
use ieee.std_logic_1164.all;

entity PopMachine_Controller_FSM is
port (
    clk : in std_logic;
    clr : in std_logic;
    coin_ack, coin_retired, seq30, sgt30, pop_retired : in std_logic;
    clr_cnt, change_dec, drop_pop, return_nickel, add_cnt, ld_cnt : out std_logic;
    current_state : out std_logic_vector(3 downto 0)
);
end PopMachine_Controller_FSM;

architecture rtl of PopMachine_Controller_FSM is

type t_State is (idle, state1, state2, state3, state4, state5, 
                 state6, state7, state8);
signal State, NextState : t_State;

begin
    
    with State select current_state <=
        "0000" when idle,
        "0001" when state1,
        "0010" when state2,
        "0011" when state3,
        "0100" when state4,
        "0101" when state5,
        "0110" when state6,
        "0111" when state7,
        "1000" when state8,
        "1111" when others;

    --------------------------------------------------------------------
    -- STATE REGISTER
    --------------------------------------------------------------------
    next_process: process(clk)
    begin
        if rising_edge(clk) then
            if clr = '1' then
                State <= idle;
            else
                State <= NextState;
            end if;
        end if;
    end process next_process;

    --------------------------------------------------------------------
    -- NEXT STATE LOGIC
    --------------------------------------------------------------------
    state_process: process(State, coin_ack, coin_retired, seq30, sgt30, pop_retired)
    begin
        NextState <= State;

        case State is

            ----------------------------------------------------------------
            -- idle: wait for coin
            ----------------------------------------------------------------
            when idle =>
                if coin_ack = '1' then
                    NextState <= state7;  -- add_cnt = 1
                end if;

            ----------------------------------------------------------------
            -- state7: add_cnt pulse
            ----------------------------------------------------------------
            when state7 =>
                NextState <= state1;

            ----------------------------------------------------------------
            -- state1: ld_cnt pulse
            ----------------------------------------------------------------
            when state1 =>
                NextState <= state2;

            ----------------------------------------------------------------
            -- state2: wait for coin_ack falling edge
            ----------------------------------------------------------------
            when state2 =>
                if coin_ack = '0' then
                    if sgt30 = '1' then
                        NextState <= state3;  -- start returning change
                    elsif seq30 = '1' then
                        NextState <= state5;  -- exact amount → drop pop
                    else
                        NextState <= idle;    -- accept more coins
                    end if;
                end if;

            ----------------------------------------------------------------
            -- state3: return nickel, wait for coin_retired
            ----------------------------------------------------------------
            when state3 =>
                if coin_retired = '1' then
                    NextState <= state8;      -- change_dec
                end if;

            ----------------------------------------------------------------
            -- state8: change_dec pulse
            ----------------------------------------------------------------
            when state8 =>
                if seq30 = '1' then
                    NextState <= state5;      -- enough for pop
                else
                    NextState <= state3;      -- return more change
                end if;

            ----------------------------------------------------------------
            -- state5: drop_pop, wait for pop_retired
            ----------------------------------------------------------------
            when state5 =>
                if pop_retired = '1' then
                    NextState <= state6;
                end if;

            ----------------------------------------------------------------
            -- state6: clr_cnt pulse, then go idle
            ----------------------------------------------------------------
            when state6 =>
                NextState <= idle;

            ----------------------------------------------------------------
            -- unused but kept for completeness
            ----------------------------------------------------------------
            when state4 =>
                NextState <= idle;

            when others =>
                NextState <= idle;

        end case;
    end process state_process;

    --------------------------------------------------------------------
    -- OUTPUT LOGIC
    --------------------------------------------------------------------
    output_process: process(State)
    begin
        case State is
            when idle =>
                clr_cnt <= '0'; 
                change_dec <= '0';
                drop_pop <= '0';
                return_nickel <= '0';
                add_cnt <= '0';
                ld_cnt <= '0';

            when state7 =>
                clr_cnt <= '0'; 
                change_dec <= '0';
                drop_pop <= '0';
                return_nickel <= '0';
                add_cnt <= '1';   -- add pulse
                ld_cnt <= '0';

            when state1 =>
                clr_cnt <= '0'; 
                change_dec <= '0';
                drop_pop <= '0';
                return_nickel <= '0';
                add_cnt <= '0';
                ld_cnt <= '1';    -- load pulse

            when state2 =>
                clr_cnt <= '0'; 
                change_dec <= '0';
                drop_pop <= '0';
                return_nickel <= '0';
                add_cnt <= '0';
                ld_cnt <= '0';

            when state3 =>
                clr_cnt <= '0'; 
                change_dec <= '0';
                drop_pop <= '0';
                return_nickel <= '1'; -- return nickel
                add_cnt <= '0';
                ld_cnt <= '0';

            when state8 =>
                clr_cnt <= '0'; 
                change_dec <= '1'; -- decrement change
                drop_pop <= '0';
                return_nickel <= '0';
                add_cnt <= '0';
                ld_cnt <= '0';

            when state4 =>
                clr_cnt <= '0'; 
                change_dec <= '0';
                drop_pop <= '0';
                return_nickel <= '0';
                add_cnt <= '0';
                ld_cnt <= '0';

            when state5 =>
                clr_cnt <= '0'; 
                change_dec <= '0';
                drop_pop <= '1'; -- drop pop
                return_nickel <= '0';
                add_cnt <= '0';
                ld_cnt <= '0';

            when state6 =>
                clr_cnt <= '1';  -- clear counter
                change_dec <= '0';
                drop_pop <= '0';
                return_nickel <= '0';
                add_cnt <= '0';
                ld_cnt <= '0';

            when others =>
                clr_cnt <= '0'; 
                change_dec <= '0';
                drop_pop <= '0';
                return_nickel <= '0';
                add_cnt <= '0';
                ld_cnt <= '0';

        end case;
   end process output_process;
    
end architecture rtl;